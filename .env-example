# ============================================================================
#  .env  —  kopiere zu  .env  und fuelle die Werte aus:  cp .env.example .env
# ============================================================================

# --- HAUPT-LLM auswaehlen (genau EINES! sonst doppelter VRAM-Verbrauch) -----
# Schaltet das Hauptmodell um, OHNE den restlichen Stack zu beruehren. Es laeuft
# IMMER nur EINES (Docker-Compose-Profil). Erreichbar bleibt es unter Hostname
# "vllm-main:5568" und Modell-ID "main" -> Agent/OWUI/RAGFlow unveraendert.
#   main-nemotron    -> nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4 (EMPFOHLEN):
#                       hybrides Mamba-MoE 30B/3B-aktiv, NVFP4 + FP8-KV, bis 1M Kontext,
#                       DSpark-Speculative-Decoding. Braucht VLLM_IMAGE >= v0.27.1.
#   main-qwen        -> Qwen3.6-35B-A3B-NVFP4, MIT MTP-Speculative-Decoding
#   main-qwen-plain  -> unsloth/Qwen3.6-27B-NVFP4 OHNE MTP: sauberes Structured Output
#                       (response_format) -> gut fuer mem0 infer=true. Erprobter Fallback.
# Genau EIN main-Profil eintragen. "mem0struct" = CPU-Helfer (llama.cpp, ~0 VRAM):
# bedient mem0 UND OWUIs Task-Modell (Titel/Tags/Suchqueries) -> KEIN GPU-Helfer noetig.
COMPOSE_PROFILES=main-nemotron,mem0struct

# --- Nemotron-Stellschrauben (nur fuer Profil main-nemotron) -----------------
# Kontextfenster (Modell kann bis 1.048.576; 260k ist der Stack-Zielwert).
NEMOTRON_MAX_LEN=260000
# VRAM-Budget-Anteil. 0.40 = ~38 GB von 96 GB: ~18 GB Gewichte (NVFP4) + DSpark-Draft
# + FP8-KV. Der Mamba-Hybrid braucht bei langem Kontext WENIGER KV als ein reines
# Transformer-Modell. Startlog zeigt "GPU KV cache size" -> bei Luft auf 0.35 senken,
# bei "max seq len ... larger than ... KV cache" erhoehen.
NEMOTRON_GPU_UTIL=0.40
# Speculative Decoding (DSpark-Draft-Checkpoint): Anzahl spekulierter Tokens.
NEMOTRON_SPEC_TOKENS=3
# Tool-Calling-Fix laut NVIDIA-Modellkarte: ohne dieses chat_template_kwarg liefert
# Nemotron beim Tool-Calling eine Antwort MIT tool_calls, aber LEEREM content —
# fuer den PydanticAI-Agenten (AGENT_IMPL=pydantic) also relevant. Bei main-nemotron
# auf true setzen; fuer die Qwen-Profile unnoetig (Default false).
LLM_FORCE_NONEMPTY_CONTENT=true
# Token-Budget fuer OWUI-Hintergrundtasks (Titel/Tags/Suchqueries). Bei Reasoning-
# Modellen zaehlt der Denkprozess MIT -> zu klein = leerer content.
TASK_MAX_TOKENS=4096

# --- GPU-Helfer (qwen-helper) optional ergaenzen ----------------------------
# Standardmaessig AUS (VRAM frei). Falls doch gewuenscht: ",helper" anhaengen, also
# COMPOSE_PROFILES=main-qwen,mem0struct,helper. mem0/Task laufen aber ohnehin auf CPU.
# --- Task-Modell ganz aus (z.B. wenn 'mem0struct' nicht laeuft) -------------
# OWUI_OPENAI_API_BASE_URLS=http://agent:9000/v1
# OWUI_OPENAI_API_KEYS=not-needed
# OWUI_ENABLE_TASKS=false

# --- vLLM-Image pinnen (gilt fuer ALLE vLLM-Dienste) ------------------------
# vLLM-Image. STABILES Release: Nemotron 3.5 Lightning verlangt laut offizieller
# vLLM-Recipe MINDESTENS 0.27.1 — genau das ist auch der aktuelle stabile Stand (08/2026).
# ACHTUNG: gilt fuer ALLE vLLM-Container (main-nemotron, main-qwen*, helper, embed).
# Host-Treiber 610.x/CUDA 13.3 ist abwaertskompatibel zu den cu12x-Images.
VLLM_IMAGE=vllm/vllm-openai:v0.27.1

# --- Tunables, die du selbst drehst (hier statt in der docker-compose.yml!) --
# So vermeidest du Merge-Konflikte beim 'git pull': NICHT die getrackte
# docker-compose.yml editieren, sondern diese .env (ist gitignored).
#
# RAGFlow-Embedder (vllm-embed): Modell, Kontextlaenge, VRAM-Deckel.
#  - 4B (Default hier): 2560 Dim, ~7 GB, SCHLANKER FP16-Lade-Peak -> kein Init-OOM.
#  - 8B (staerker, MTEB-#1): ~10-13 GB real, aber online-FP8 laedt erst die FP16-
#    Gewichte (~16 GB Lade-Peak) -> EMBED_GPU_UTIL >= ~0.30, sonst OOM beim Init.
#  ACHTUNG: Dimension haengt am Modell (4B=2560, 8B=4096). Wechsel -> RAGFlow-KB
#  neu bauen UND morphik/morphik.toml [embedding].dimensions angleichen!
EMBED_MODEL=Qwen/Qwen3-Embedding-4B
EMBED_MAX_LEN=4096        # Embedder-Kontext (RAG-Chunks << 4096; hoeher = mehr VRAM)
EMBED_GPU_UTIL=0.15       # 4B: 0.15 reicht; 8B braeuchte >=0.30 (FP16-Lade-Peak)

# --- browserless (JS-Scraper fuer tiefe Websuche) ---------------------------
# Interner Token zwischen OWUI und dem browserless-Dienst (nur aistack-core, kein
# Port nach aussen) -> beliebiger String, muss in beiden gleich sein (Compose macht das).
BROWSERLESS_TOKEN=aistack-browserless

# --- research-agent: Domain-Vertrauensliste (gewichtete Web-Gegenpruefung) ---
# Hauptliste: agent/trust_domains.txt (gemountet, live editierbar -> agent neu starten).
# Datei-Format: "domain [tier] [topics]"  z.B.  *.gv.at trusted recht,verwaltung
#   - '*.xy.com' == 'xy.com' (ganze Domain inkl. Subdomains)
#   - topics optional ('*'=alle); eine themen-Quelle zaehlt voll nur, wenn das Thema passt
# Hier nur SCHNELL-Ergaenzungen ohne Datei-Edit (kommagetrennt, Thema '*'; Subdomains matchen):
#   TRUST_DOMAINS      -> zusaetzlich vertrauenswuerdig (zaehlen STARK in der Quote)
#   LOW_TRUST_DOMAINS  -> zusaetzlich gering (Foren/SEO; zaehlen schwach)
TRUST_DOMAINS=
LOW_TRUST_DOMAINS=
# Auto-Blocklist fuer den low-Tier. Egress macht NUR der isolierte 'blocklist-fetcher'-
# Sidecar (Profil "blocklist") -> der agent selbst hat KEINEN Internet-Egress (DSGVO/PII).
# OPT-IN (zwei Schritte): 1) ",blocklist" zu COMPOSE_PROFILES, 2) BLOCKLIST_URL setzen.
# Kuratierte trusted-Domains haben Vorrang (werden NIE geblockt). Eine Liste waehlen:
#   StevenBlack (hosts):    https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts
#   HaGeZi light (domains): https://raw.githubusercontent.com/hagezi/dns-blocklists/main/domains/light.txt
#   OISD small (domains):   https://small.oisd.nl/domains       (URL ggf. gegen Projektseite pruefen)
BLOCKLIST_URL=
BLOCKLIST_REFRESH_MIN=60       # Sidecar-Fetch- UND Agent-Neuladen-Intervall (Minuten)
# Memory (mem0): 'auto' waehlt der Reihe nach: CPU-Struct-Sidecar (Profil "mem0struct",
# ~0 VRAM, garantiertes JSON) -> GPU-Helfer -> Hauptmodell -> aus.
# Hart aus: MEM0_ENABLED=false.
MEM0_ENABLED=true
# LLM-Wahl fuer mem0: 'auto' (Default, Reihenfolge wie oben). Fuer eine FESTE Wahl
# beide Zeilen setzen — URL + served-model-name AN dieser URL. Typisch bei
# MEM0_INFER=true, wenn der 2-Call-Memory-Manager bewusst auf dem grossen
# autoregressiven Main laufen soll (statt auf dem kleinen mem0-struct):
#   qwen-Main (mtp ODER plain):   http://vllm-main:5568/v1     + MEM0_LLM_MODEL=main
#   GPU-Helfer (Profil helper):   http://vllm-helper:30001/v1  + MEM0_LLM_MODEL=qwen-helper
#   CPU-Struct (Profil mem0struct): http://mem0-struct:8088/v1 + MEM0_LLM_MODEL=mem0-struct
# Default hier: FEST auf den Main (robust, unabhaengig vom mem0struct-Profil; bei
# MEM0_INFER=false ohnehin kein LLM-Call). Alternative: 'auto' (Reihenfolge wie oben).
MEM0_LLM_BASE_URL=http://vllm-main:5568/v1
MEM0_LLM_MODEL=main            # served-model-name an obiger URL (alle Main-Varianten: "main")
# Speicher-Modus: false (Default) = robustes Direkt-Speichern der User-Aussagen ohne
# mem0s fragilen 2-Call-Memory-Manager (der mit kleinen lokalen Modellen leeres JSON
# liefert -> "Expecting value"). true = destillierte Fakten, aber braucht ein sehr
# zuverlaessiges JSON-LLM (grosse autoregressive Modelle).
MEM0_INFER=false
# CPU-Struct-Helfer (bedient mem0 UND OWUIs Task-Modell, ~0 VRAM). Profil "mem0struct".
# WICHTIG: NICHT-Reasoning-Modell nehmen! Reasoning-Modelle (Qwen3.5 etc.) denken bei
# komplexen Prompts trotz '--reasoning off' -> GBNF/JSON-Garantie weg (#20345) -> mem0
# "Expecting value: line 1 column 1". Qwen2.5-Instruct hat KEIN Thinking -> immer JSON.
# (Falls der Pull zickt: Qwen/Qwen2.5-1.5B-Instruct-GGUF:Q4_K_M als kleinere Variante.)
MEM0_STRUCT_HF=Qwen/Qwen2.5-3B-Instruct-GGUF:Q4_K_M
MEM0_STRUCT_THREADS=6
MEM0_STRUCT_CTX=16384     # Kontext, wird durch --parallel(2) geteilt -> 8192/Slot.
#                         # mem0s Memory-Manager + max_tokens=3000 braucht ~4600/Call;
#                         # zu klein -> leere Antwort ("Expecting value: line 1 column 1").

# --- Zentrales Logging / Observability (Loki + Grafana + Dozzle + Promtail) --
# Sammelt die Logs ALLER Container an EINER Stelle (Grafana = durchsuchbar +
# persistent; Dozzle = Live-Viewer). Standardmaessig AN (start.sh).
# Komplett aus:   LOGGING_STACK=0 ./start.sh
GRAFANA_PORT=3011          # Web-UI: http://localhost:3011  (Login admin/admin; anon. Zugriff an)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin     # bei Bedarf aendern (openssl rand -hex 16)
DOZZLE_PORT=8085           # Live-Log-Viewer aller Container: http://localhost:8085
NETDATA_PORT=19999         # Netdata Live-Metriken (GPU/Disk/Netz, eigene UI): http://localhost:19999
PROMETHEUS_PORT=9090       # Prometheus (Metrik-Backend fuer Grafana): http://localhost:9090
#
# Log-Level je Dienst. Default: Such-/RAG-/Agent-Pfad auf DEBUG (damit man WARUM-
# Fragen wie "Websuche 0 Treffer" beantworten kann), Rest schlank. vLLM-Dienste
# werden BEWUSST NICHT angefasst (loggen ohnehin ausfuehrlich).
OWUI_LOG_LEVEL=DEBUG       # Open WebUI: zeigt Query-Bau -> Proxy -> Loader-Pfad
PRESIDIO_LOG_LEVEL=DEBUG   # Masking-Proxy: loggt jetzt auch die Treffer-ANZAHL von SearXNG
SEARXNG_DEBUG=true         # SearXNG: per-Engine-Logs (welche Engine leer/rate-limitiert ist)
AGENT_LOG_LEVEL=DEBUG      # research-agent
QDRANT_LOG_LEVEL=INFO      # DEBUG ist sehr laut -> nur bei Qdrant-Problemen hochdrehen
TEI_LOG_LEVEL=info         # Mem0-Embedder (text-embeddings-inference, RUST_LOG)

# --- Such-Backend: SearXNG (Default, lokal/kostenlos) ODER externe Such-API ---
# Wird deine Server-IP von Suchmaschinen "soft-geblockt" (SearXNG liefert HTTP 200
# + 0 Treffer ohne Fehler), liefert eine offizielle Such-API IP-UNABHAENGIG
# Ergebnisse. WICHTIG: Die PII-Maskierung bleibt voll aktiv (erst maskieren ->
# dann API), egal welches Backend. OWUI/Agent merken nichts (gleiches JSON).
# Umschalten: SEARCH_BACKEND setzen + zugehoerigen Key, dann presidio-proxy neu:
#   docker compose up -d --force-recreate presidio-proxy
#   Werte:  searxng | brave | tavily | serper | google_pse
SEARCH_BACKEND=searxng
WEB_SEARCH_RESULT_COUNT=10
# Anti-Flood-Drossel: serialisiert ALLE Suchen (genau 1 Call gleichzeitig) und
# haelt zwischen aufeinanderfolgenden Calls eine ZUFALLS-Pause ein. Verhindert,
# dass OWUI bei einem Prompt mit Websuche mehrere Engine-/API-Anfragen parallel
# feuert (Schutz vor 429/CAPTCHA bzw. Brave-Free = 1 req/s). Gilt fuer SearXNG
# UND die API-Backends. Erster Call wartet nicht; Pause nur ZWISCHEN Calls.
SEARCH_THROTTLE=true
SEARCH_MIN_PAUSE=5          # Sekunden (untere Grenze)
SEARCH_MAX_PAUSE=10         # Sekunden (obere Grenze)
# Brave Search API — privacy-/EU-orientiert, eigener Index. Free-Tier ~2000/Monat.
#   Key: https://api-dashboard.search.brave.com/
BRAVE_API_KEY=
# Tavily — fuer LLM/RAG optimiert, sehr saubere Treffer. Free-Tier ~1000/Monat.
#   Key: https://app.tavily.com/
TAVILY_API_KEY=
# Serper.dev — Google-Ergebnisse, schnell/guenstig, 2500 Gratis-Credits.
#   Key: https://serper.dev/
SERPER_API_KEY=
# Google Programmable Search Engine — offizielle Google-API, 100 Abfragen/Tag gratis.
#   Keys: https://developers.google.com/custom-search/v1/introduction
GOOGLE_PSE_API_KEY=
GOOGLE_PSE_ENGINE_ID=

# --- HuggingFace (einmaliger Modell-Download von vLLM/TEI) ------------------
# Token nur noetig fuer gated Modelle. Nach dem Download kannst du in der
# docker-compose.yml HF_HUB_OFFLINE=1 setzen -> danach laeuft alles ohne Netz.
HF_TOKEN=hf_

# --- Zufalls-Secrets (jeweils generieren: openssl rand -hex 32) -------------
WEBUI_SECRET_KEY=0f0d
SEARXNG_SECRET=22824
JUPYTER_TOKEN=2852

# --- Agent-Variante --------------------------------------------------------
# "pydantic" (Default) = Tool-Calling-Agent: RAG zuerst, dann Web-GEGENPRUEFUNG
#   (aktuell?/widerspruechlich?, PII-maskiert) und Code — das Modell waehlt die
#   Werkzeuge selbst. Braucht die 1.x von pydantic-ai (in agent/requirements.txt
#   gesetzt) -> Agent-Image neu bauen: docker compose build agent.
# "langgraph" = deterministischer Critic-Loop (gather->draft->execute->verify->critic).
#   Die verify-Node prueft strittige/zeitkritische Aussagen GARANTIERT gegen das Web
#   (PII-maskiert) — nicht dem Modell-Ermessen ueberlassen wie bei pydantic.
AGENT_IMPL=pydantic
# Nur langgraph: wie viele Pruef-Suchanfragen pro Antwort (Latenz: jede Websuche wird
# vom presidio-Proxy gedrosselt) und wie viele Revise-Runden der Critic-Loop max. dreht.
VERIFY_MAX_QUERIES=3
VERIFY_MAX_ITER=3

# --- Anbindung an deine BESTEHENDE RAGFlow-Instanz --------------------------
# Wird vom Agent als Retrieval-Tool genutzt. RAGFlow selbst ist NICHT Teil
# dieses Compose (du betreibst es bereits separat).
# URL aus Sicht des agent-Containers. Laeuft RAGFlow auf dem Host:
#   http://host.docker.internal:9380
# Laeuft es im selben shared-ai-network: http://ragflow:9380
RAGFLOW_API_URL=http://host.docker.internal:9380
RAGFLOW_API_KEY=ragflow-
# Komma-getrennte Dataset-/Knowledge-Base-IDs, in denen gesucht werden soll:
RAGFLOW_DATASET_IDS=fe1

# --- Upload-Weiche (ingest-router): Chat-Uploads automatisch einsortieren ----
# Der ingest-router klassifiziert hochgeladene Dateien und leitet sie weiter:
# Bild-/Scan-/Tabellen-lastig -> Morphik, sonst -> RAGFlow.
# Gefuettert wird der Router auf ZWEI Wegen (einer reicht):
#   a) AGENT_AUTO_INGEST=true (Default, EMPFOHLEN): der Agent schickt frische Chat-
#      Uploads selbst an den Sidecar -> repo-synchron, KEIN manuelles Einfuegen noetig,
#      OWUI bleibt reine UI. Rein lokal (kein Egress).
#   b) OWUI-Filter open-webui/filters/ingest_router.py (muss in OWUI->Admin->Functions
#      eingefuegt/aktiv sein). Bei aktivem (a) NICHT noetig -> sonst doppelter Ingest.
AGENT_AUTO_INGEST=true
# INGEST_ROUTER_URL=http://ingest-router:8000   # interner Sidecar (Default passt)
# Ziel-Dataset/KB fuer TEXT-Uploads (MUSS gesetzt sein; meist = erste RAGFLOW_DATASET_IDS):
RAGFLOW_INGEST_DATASET_ID=fe1
# Klassifikation justieren (Defaults sind sinnvoll):
PDF_TEXT_MIN_CHARS_PER_PAGE=200   # PDF darunter = Scan/Bild -> Morphik
PDF_TABLE_PAGE_RATIO=0.34         # Tabellen auf >= 34% der Stichprobe -> Morphik
MAX_SAMPLE_PAGES=5                # so viele Seiten am Anfang pruefen
SPREADSHEET_TO_MORPHIK=true       # xlsx/csv/... als tabellenlastig an Morphik
INGEST_LOG_LEVEL=INFO

# --- Code-Ausfuehrung: microVM-Executor (Microsandbox) ----------------------
# Default: Host-Dienst (siehe microsandbox-executor/README.md). Container-Variante
# (--profile microvm): http://microsandbox-executor:8077/run
MSB_EXECUTOR_URL=http://host.docker.internal:8077/run
# OCI-Image fuer die microVM (fuer Office-Files ein Image mit python-docx/openpyxl/... setzen):
MSB_IMAGE=python

# --- Upgrade-Profile (nur relevant, wenn aktiviert) -------------------------
# Morphik (--profile morphik):
MORPHIK_API_URL=http://morphik:8000
# HINWEIS: Morphik authentifiziert per JWT. agent + ingest-router erzeugen den
# Token automatisch (HS256, signiert mit WEBUI_SECRET_KEY = dem Secret des
# morphik-Dienstes) -> du musst NICHTS setzen. MORPHIK_API_KEY wird dabei ignoriert
# (war die Ursache fuer 401 "Not enough segments"). Eigenes Secret nur bei Bedarf:
# MORPHIK_JWT_SECRET=...   (muss dann auch dem morphik-Dienst gegeben werden)
MORPHIK_API_KEY=fb
MORPHIK_DB_PASSWORD=bitte-aendern
# open-computer-use (--profile computer-use):
OCU_DB_PASSWORD=bitte-aendern
